import java.util.*;
 
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
 
        int t = sc.nextInt();
 
        while (t-- > 0) {
            int n = sc.nextInt();
            int k = sc.nextInt();
 
            int[] a = new int[n];
 
            for (int i = 0; i < n; i++) {
                a[i] = sc.nextInt();
            }
 
        boolean p = false;
 
        for (int i = 0; i < n; i++) {
            if (a[i] == k) {
                p = true;
                break;
            }
    }
 
if (p) {
    System.out.println("YES");
} else {
System.out.println("NO");
}
}
}
}